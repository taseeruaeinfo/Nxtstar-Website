{
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    { "source": "/home", "destination": "/", "permanent": true },
    { "source": "/blog", "destination": "/blogs", "permanent": true },
    { "source": "/services/creators", "destination": "/services/advertiser-permit", "permanent": true },
    { "source": "/services/registration-licenses", "destination": "/services", "permanent": true },
    { "source": "/services/visa-pro", "destination": "/services/pro", "permanent": true },
    { "source": "/services/golden-visa", "destination": "/services/visa", "permanent": true },
    { "source": "/services/taxation", "destination": "/services/accounting", "permanent": true },
    { "source": "/services/corporate-structuring", "destination": "/services", "permanent": true },
    { "source": "/services/website", "destination": "/services", "permanent": true }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    }
  ]
}
